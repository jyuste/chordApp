{
  "name": "entrecuerdas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "test:offline": "playwright test --config=playwright.offline.config.ts",
    "check": "vue-tsc -b",
    "format": "prettier --write src tests *.ts *.json *.jsonc *.md docs"
  },
  "dependencies": {
    "@lucide/vue": "^1.59.0",
    "dexie": "^4.0.0",
    "pinia": "^3.0.0",
    "tonal": "^6.4.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.89.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
